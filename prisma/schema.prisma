generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  EGYPT_MANAGER
  MOROCCO_MANAGER
  SELLER
}

enum MarketScope {
  ALL
  EGYPT
  MOROCCO
}

enum ReturnCondition {
  RESELLABLE
  DAMAGED
  OTHER
}

enum RefundStatus {
  PENDING
  REFUNDED
  REJECTED
}

enum TargetType {
  REVENUE
  SALES_COUNT
}

enum ProductStatus {
  ACTIVE
  DRAFT
  HIDDEN
  OUT_OF_STOCK
  COMING_SOON
  ARCHIVED
}

enum InventoryType {
  PHYSICAL_STOCK
  ON_DEMAND
  SUPPLIER_STOCK
  PREORDER
}

enum Gender {
  MEN
  WOMEN
  KIDS
  UNISEX
  NA
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
}

model User {
  id           String              @id @default(cuid())
  name         String
  email        String              @unique
  passwordHash String
  role         Role
  username     String?             @unique
  active       Boolean             @default(true)
  marketScope  MarketScope         @default(ALL)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  sales        Sale[]
  movements    InventoryMovement[]
  audits       AuditLog[]
  returns      Return[]
  targets      Target[]
  shifts       ShiftClose[]        @relation("ShiftSeller")
  closedShifts ShiftClose[]        @relation("ShiftCloser")
}

model Market {
  id             String                @id @default(cuid())
  code           String                @unique
  name           String
  currency       String                @db.VarChar(3)
  timezone       String                @default("UTC")
  listings       MarketListing[]
  inventories    Inventory[]
  sales          Sale[]
  customers      Customer[]
  suppliers      Supplier[]
  auditLogs      AuditLog[]
  bundleListings BundleMarketListing[]
  returns        Return[]
  targets        Target[]
  shifts         ShiftClose[]
}

model Department {
  id         String     @id @default(cuid())
  name       String     @unique
  categories Category[]
  products   Product[]
}

model Category {
  id           String     @id @default(cuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  parentId     String?
  parent       Category?  @relation("Subcategories", fields: [parentId], references: [id])
  children     Category[] @relation("Subcategories")
  products     Product[]
  archived     Boolean    @default(false)
}

model Supplier {
  id                String            @id @default(cuid())
  name              String
  contactPerson     String?
  phone             String?
  whatsapp          String?
  marketId          String?
  market            Market?           @relation(fields: [marketId], references: [id])
  location          String?
  policy            String?
  moq               String?
  shippingAvailable Boolean           @default(false)
  notes             String?
  products          ProductSupplier[]
  listings          MarketListing[]
}

model Product {
  id            String            @id @default(cuid())
  sku           String            @unique
  nameAr        String
  nameEn        String
  descriptionAr String?
  descriptionEn String?
  departmentId  String?
  department    Department?       @relation(fields: [departmentId], references: [id])
  categoryId    String?
  category      Category?         @relation(fields: [categoryId], references: [id])
  brand         String?
  model         String?
  gender        Gender            @default(NA)
  status        ProductStatus     @default(DRAFT)
  internalNotes String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  variants      ProductVariant[]
  listings      MarketListing[]
  suppliers     ProductSupplier[]
  saleItems     SaleItem[]
  bundleItems   BundleItem[]
  images        ProductImage[]    @relation("ProductImages")
}

model ProductVariant {
  id           String          @id @default(cuid())
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku          String          @unique
  color        String?
  size         String?
  material     String?
  supplierCode String?
  barcode      String?
  images       ProductImage[]  @relation("VariantImages")
  listings     MarketListing[]
  saleItems    SaleItem[]
  bundleItems  BundleItem[]
}

model ProductImage {
  id        String          @id @default(cuid())
  url       String
  alt       String?
  productId String?
  product   Product?        @relation("ProductImages", fields: [productId], references: [id], onDelete: Restrict)
  variantId String?
  variant   ProductVariant? @relation("VariantImages", fields: [variantId], references: [id], onDelete: Restrict)
}

model ProductSupplier {
  productId  String
  supplierId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@id([productId, supplierId])
}

model MarketListing {
  id            String          @id @default(cuid())
  productId     String
  variantId     String?
  marketId      String
  supplierId    String?
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  market        Market          @relation(fields: [marketId], references: [id])
  supplier      Supplier?       @relation(fields: [supplierId], references: [id])
  cost          Decimal         @db.Decimal(12, 2)
  price         Decimal         @db.Decimal(12, 2)
  compareAt     Decimal?        @db.Decimal(12, 2)
  available     Boolean         @default(true)
  inventoryType InventoryType   @default(PHYSICAL_STOCK)
  minimumStock  Int             @default(0)
  notes         String?
  inventory     Inventory?
  saleItems     SaleItem[]

  @@unique([variantId, marketId])
}

model Inventory {
  id            String              @id @default(cuid())
  listingId     String              @unique
  marketId      String
  listing       MarketListing       @relation(fields: [listingId], references: [id], onDelete: Restrict)
  market        Market              @relation(fields: [marketId], references: [id])
  currentStock  Int                 @default(0)
  reservedStock Int                 @default(0)
  movements     InventoryMovement[]
}

model InventoryMovement {
  id               String    @id @default(cuid())
  inventoryId      String
  inventory        Inventory @relation(fields: [inventoryId], references: [id])
  quantityChange   Int
  previousQuantity Int
  newQuantity      Int
  reason           String
  reference        String?
  userId           String?
  user             User?     @relation(fields: [userId], references: [id])
  createdAt        DateTime  @default(now())
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  marketId  String
  market    Market   @relation(fields: [marketId], references: [id])
  city      String?
  address   String?
  notes     String?
  sales     Sale[]
  createdAt DateTime @default(now())
}

model Sale {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  marketId      String
  market        Market        @relation(fields: [marketId], references: [id])
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  customerName  String?
  customerPhone String?
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  shipping      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paymentMethod String?
  paymentStatus PaymentStatus @default(PENDING)
  status        SaleStatus    @default(DRAFT)
  notes         String?
  createdById   String?
  createdBy     User?         @relation(fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         SaleItem[]
  returns       Return[]
}

model SaleItem {
  id           String          @id @default(cuid())
  saleId       String
  sale         Sale            @relation(fields: [saleId], references: [id], onDelete: Restrict)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  listingId    String
  listing      MarketListing   @relation(fields: [listingId], references: [id])
  sku          String
  productName  String
  variantLabel String?
  quantity     Int
  unitPrice    Decimal         @db.Decimal(12, 2)
  unitCost     Decimal?        @db.Decimal(12, 2)
  lineTotal    Decimal         @db.Decimal(12, 2)
  marketCode   String          @default("")
  currency     String          @default("") @db.VarChar(3)
  returnItems  ReturnItem[]
}

model Bundle {
  id       String                @id @default(cuid())
  name     String
  items    BundleItem[]
  listings BundleMarketListing[]
  status   ProductStatus         @default(DRAFT)
}

model BundleItem {
  id        String          @id @default(cuid())
  bundleId  String
  bundle    Bundle          @relation(fields: [bundleId], references: [id])
  productId String?
  product   Product?        @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int
}

model BundleMarketListing {
  id              String  @id @default(cuid())
  bundleId        String
  bundle          Bundle  @relation(fields: [bundleId], references: [id])
  marketId        String
  market          Market  @relation(fields: [marketId], references: [id])
  cost            Decimal @db.Decimal(12, 2)
  individualTotal Decimal @db.Decimal(12, 2)
  price           Decimal @db.Decimal(12, 2)

  @@unique([bundleId, marketId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  marketId  String?
  market    Market?  @relation(fields: [marketId], references: [id])
  metadata  Json?
  createdAt DateTime @default(now())
}

model Return {
  id           String       @id @default(cuid())
  returnNumber String       @unique
  saleId       String
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  marketId     String
  market       Market       @relation(fields: [marketId], references: [id])
  createdById  String
  createdBy    User         @relation(fields: [createdById], references: [id])
  reason       String?
  refundAmount Decimal      @default(0) @db.Decimal(12, 2)
  refundStatus RefundStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  items        ReturnItem[]
}

model ReturnItem {
  id         String          @id @default(cuid())
  returnId   String
  return     Return          @relation(fields: [returnId], references: [id], onDelete: Restrict)
  saleItemId String
  saleItem   SaleItem        @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  quantity   Int
  unitPrice  Decimal         @db.Decimal(12, 2)
  condition  ReturnCondition
}

model Target {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  marketId  String
  market    Market     @relation(fields: [marketId], references: [id])
  type      TargetType
  amount    Decimal    @db.Decimal(12, 2)
  startDate DateTime
  endDate   DateTime
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model ShiftClose {
  id               String   @id @default(cuid())
  sellerId         String
  seller           User     @relation("ShiftSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  marketId         String
  market           Market   @relation(fields: [marketId], references: [id])
  periodStart      DateTime
  periodEnd        DateTime
  transactionCount Int
  grossSales       Decimal  @db.Decimal(12, 2)
  returnsTotal     Decimal  @default(0) @db.Decimal(12, 2)
  netSales         Decimal  @db.Decimal(12, 2)
  paymentBreakdown Json
  notes            String?
  closedAt         DateTime @default(now())
  closedById       String
  closedBy         User     @relation("ShiftCloser", fields: [closedById], references: [id], onDelete: Restrict)
}
